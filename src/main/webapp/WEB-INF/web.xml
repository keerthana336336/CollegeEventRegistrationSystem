<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>College Event Registration System</display-name>

  <!--
    Where the JSON data files are stored. Leave this out to use the default folder:
        C:\Users\<your user name>\CollegeEventRegistrationSystem\data
    You can also override it with the JVM argument  -Dcollegeevent.data.dir=D:\MyData\CollegeEventRegistrationSystem
    (see README.md). A path set with -D or the COLLEGE_EVENT_DATA_DIR environment variable wins over this value.

  <context-param>
    <param-name>collegeevent.data.dir</param-name>
    <param-value>C:/CollegeEventRegistrationSystemData</param-value>
  </context-param>
  -->

  <!-- Filters run in the order they are mapped below. Servlets and the startup listener use annotations. -->
  <filter>
    <filter-name>EncodingFilter</filter-name>
    <filter-class>com.collegeevent.filter.EncodingFilter</filter-class>
  </filter>
  <filter>
    <filter-name>CsrfFilter</filter-name>
    <filter-class>com.collegeevent.filter.CsrfFilter</filter-class>
  </filter>
  <filter>
    <filter-name>StudentAuthFilter</filter-name>
    <filter-class>com.collegeevent.filter.StudentAuthFilter</filter-class>
  </filter>
  <filter>
    <filter-name>AdminAuthFilter</filter-name>
    <filter-class>com.collegeevent.filter.AdminAuthFilter</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>EncodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>CsrfFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>StudentAuthFilter</filter-name>
    <url-pattern>/student/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AdminAuthFilter</filter-name>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>

  <session-config>
    <session-timeout>480</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <error-page>
    <error-code>403</error-code>
    <location>/WEB-INF/views/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/views/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/views/error.jsp</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/WEB-INF/views/error.jsp</location>
  </error-page>
</web-app>
